<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --azul:#7E84AE;--azul-l:#C2CBFF;--lila:#CEA2DD;--menta:#DFF3AF;
  --naranja:#F59356;--crema:#FFEAD2;--crema-l:#FFF7EF;
  --lila-l:#F9E1FF;--dorado:#F7C175;
  --texto:#2B2040;--muted:#6B6080;--border:rgba(126,132,174,0.2);
  --xtb:#E8001C;
}
body{background:var(--crema-l);color:var(--texto);font-family:'Montserrat',sans-serif;min-height:100vh;padding-bottom:48px;}

.progress-bar-wrap{position:sticky;top:0;z-index:100;background:white;border-bottom:1px solid var(--border);padding:10px 16px;display:flex;align-items:center;gap:10px;box-shadow:0 2px 12px rgba(126,132,174,.08);}
.progress-label{font-size:11px;font-weight:700;color:var(--azul);white-space:nowrap;}
.progress-track{flex:1;height:8px;background:var(--crema);border-radius:8px;overflow:hidden;}
.progress-fill{height:100%;border-radius:8px;background:linear-gradient(90deg,var(--azul) 0%,var(--lila) 100%);transition:width .6s cubic-bezier(.4,0,.2,1);}
.progress-pts{font-size:12px;font-weight:700;color:var(--azul);white-space:nowrap;min-width:36px;text-align:right;}

.day-chips{display:flex;gap:4px;padding:0 16px 8px;background:white;justify-content:center;border-bottom:1px solid var(--border);}
.chip{width:30px;height:30px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--muted);flex-shrink:0;transition:all .3s;}
.chip.done{background:var(--azul);border-color:var(--azul);color:white;}
.chip.active{border-color:var(--naranja);color:var(--naranja);}

.header{background:linear-gradient(135deg,#1a1a2e 0%,#2d2060 60%,var(--azul) 100%);padding:20px 24px 28px;text-align:center;position:relative;overflow:hidden;}
.header::after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:20px;background:var(--crema-l);border-radius:20px 20px 0 0;}
.logo-text{font-size:20px;font-weight:700;color:white;letter-spacing:.04em;}
.logo-sub{font-size:10px;color:rgba(255,255,255,.65);letter-spacing:.05em;margin-top:2px;margin-bottom:14px;}
.header-pill{display:inline-block;background:rgba(255,255,255,.2);border-radius:20px;padding:4px 12px;font-size:10px;color:white;font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px;}
.header-title{font-size:clamp(20px,5vw,30px);font-weight:700;color:white;line-height:1.2;margin-bottom:6px;}
.header-title em{font-style:italic;font-weight:400;color:var(--dorado);}
.header-sub-text{font-size:12px;color:rgba(255,255,255,.8);}

.content{max-width:600px;margin:0 auto;padding:20px 16px 0;}
.card{background:white;border:1px solid var(--border);border-radius:16px;padding:20px;margin-bottom:14px;box-shadow:0 2px 12px rgba(126,132,174,.06);}
.card-label{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--azul);margin-bottom:6px;}
.card-title{font-size:16px;font-weight:700;color:var(--texto);margin-bottom:10px;line-height:1.3;}
.card-body{font-size:13px;color:var(--muted);line-height:1.8;}
.card-body strong{color:var(--texto);font-weight:600;}

/* ALERTA DE ACCIÓN */
.accion-banner{background:linear-gradient(135deg,#1a1a2e,#2d2060);border-radius:16px;padding:20px;text-align:center;margin-bottom:14px;}
.accion-emoji{font-size:32px;margin-bottom:8px;}
.accion-title{font-size:18px;font-weight:700;color:white;margin-bottom:6px;}
.accion-sub{font-size:12px;color:rgba(255,255,255,.75);line-height:1.7;}

/* SELECTOR DE SITUACIÓN */
.situacion-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px;}
.situ-btn{border:2px solid var(--border);border-radius:12px;padding:14px 12px;text-align:center;cursor:pointer;transition:all .2s;background:var(--crema-l);}
.situ-btn:hover{border-color:var(--azul);}
.situ-btn.selected{border-color:var(--naranja);background:rgba(245,147,86,.06);}
.situ-icon{font-size:22px;margin-bottom:6px;}
.situ-name{font-size:12px;font-weight:700;color:var(--texto);}
.situ-desc{font-size:10px;color:var(--muted);margin-top:2px;line-height:1.4;}

/* CAMINO XTB — nunca invirtió */
.xtb-card{display:none;background:white;border:2px solid var(--naranja);border-radius:16px;padding:20px;margin-bottom:14px;}
.xtb-card.visible{display:block;animation:pop .4s cubic-bezier(.4,0,.2,1);}
@keyframes pop{from{transform:scale(.95);opacity:0;}to{transform:scale(1);opacity:1;}}

/* LINK XTB DESTACADO */
.xtb-banner{background:linear-gradient(135deg,var(--xtb),#a00015);border-radius:14px;padding:20px;text-align:center;margin:16px 0;}
.xtb-logo{font-size:11px;font-weight:700;letter-spacing:.2em;color:rgba(255,255,255,.7);text-transform:uppercase;margin-bottom:4px;}
.xtb-headline{font-size:17px;font-weight:700;color:white;margin-bottom:6px;line-height:1.3;}
.xtb-sub{font-size:12px;color:rgba(255,255,255,.8);margin-bottom:16px;line-height:1.6;}
.xtb-warning{font-size:11px;color:rgba(255,255,255,.9);background:rgba(0,0,0,.25);border-radius:8px;padding:8px 12px;margin-bottom:14px;font-weight:600;}
.btn-xtb{display:block;width:100%;padding:16px;background:white;border:none;border-radius:12px;color:var(--xtb);font-family:'Montserrat',sans-serif;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;text-align:center;transition:background .15s,transform .1s;letter-spacing:.02em;}
.btn-xtb:hover{background:#fff5f5;}
.btn-xtb:active{transform:scale(.98);}

/* PASOS */
.pasos{display:flex;flex-direction:column;gap:10px;margin-top:14px;}
.paso{display:flex;gap:12px;align-items:flex-start;}
.paso-num{width:28px;height:28px;border-radius:50%;background:var(--naranja);color:white;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.paso-content{}
.paso-title{font-size:13px;font-weight:700;color:var(--texto);margin-bottom:2px;}
.paso-desc{font-size:12px;color:var(--muted);line-height:1.6;}
.paso-desc strong{color:var(--texto);}

/* CAMINO YA INVIERTE */
.ya-invierte-card{display:none;background:white;border:2px solid var(--azul);border-radius:16px;padding:20px;margin-bottom:14px;}
.ya-invierte-card.visible{display:block;animation:pop .4s cubic-bezier(.4,0,.2,1);}

.opciones-grid{display:grid;grid-template-columns:1fr;gap:8px;margin-top:14px;}
.opcion-check{display:flex;align-items:flex-start;gap:12px;padding:12px 14px;background:var(--crema-l);border:1.5px solid var(--border);border-radius:12px;cursor:pointer;transition:all .2s;}
.opcion-check:hover{border-color:var(--azul);}
.opcion-check.done{border-color:#4a9e6e;background:rgba(74,158,110,.06);}
.opcion-check input[type=checkbox]{width:18px;height:18px;accent-color:var(--azul);flex-shrink:0;margin-top:1px;}
.opcion-label{font-size:13px;color:var(--texto);line-height:1.5;}
.opcion-label span{font-size:11px;color:var(--muted);display:block;margin-top:2px;}

/* CONFIRMACIÓN ACCIÓN */
.confirm-card{display:none;margin-bottom:14px;}
.confirm-card.visible{display:block;}
.confirm-inner{background:linear-gradient(135deg,var(--menta),var(--crema));border:2px solid #7abf45;border-radius:14px;padding:18px;text-align:center;}
.confirm-emoji{font-size:32px;margin-bottom:8px;}
.confirm-title{font-size:15px;font-weight:700;color:#2d5a1a;margin-bottom:6px;}
.confirm-sub{font-size:12px;color:#4a7a2a;line-height:1.6;}

/* TEXTAREA + BOTÓN */
.reflection-area{width:100%;background:var(--crema-l);border:1.5px solid var(--border);border-radius:10px;padding:12px 14px;color:var(--texto);font-family:'Montserrat',sans-serif;font-size:13px;line-height:1.7;resize:vertical;min-height:70px;margin-top:12px;transition:border-color .15s;}
.reflection-area:focus{outline:none;border-color:var(--azul);background:white;}
.reflection-area::placeholder{color:#c0bbd0;}
.btn-primary{display:block;width:100%;margin-top:12px;padding:14px;background:var(--naranja);border:none;border-radius:12px;color:white;font-family:'Montserrat',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:background .15s,transform .1s;}
.btn-primary:hover{background:#e07d3d;}
.btn-primary:active{transform:scale(.98);}
.btn-primary.saved{background:#4a9e6e;}

/* CELEBRACIÓN */
.celebracion{display:none;margin-top:14px;background:linear-gradient(135deg,var(--menta) 0%,var(--crema) 100%);border:2px solid #7abf45;border-radius:16px;padding:20px;}
.celebracion.visible{display:block;animation:pop .4s cubic-bezier(.4,0,.2,1);}
.celebracion-emoji{font-size:36px;margin-bottom:8px;text-align:center;}
.celebracion-title{font-size:16px;font-weight:700;color:#2d5a1a;margin-bottom:6px;text-align:center;}
.celebracion-sub{font-size:12px;color:#4a7a2a;line-height:1.7;margin-bottom:16px;text-align:center;}
.wa-steps{display:flex;flex-direction:column;gap:10px;}
.wa-step-label{font-size:10px;font-weight:700;color:#4a7a2a;text-transform:uppercase;letter-spacing:.1em;margin-bottom:4px;}
.msg-box{background:white;border:1px solid #7abf45;border-radius:10px;padding:12px 14px;font-size:12px;color:var(--texto);line-height:1.7;white-space:pre-line;}
.btn-copy{display:block;width:100%;margin-top:8px;padding:10px;background:white;border:2px solid #7abf45;border-radius:10px;color:#2d5a1a;font-family:'Montserrat',sans-serif;font-size:12px;font-weight:700;cursor:pointer;}
.btn-copy:hover{background:var(--menta);}
.btn-wa-grupo{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:13px;background:#25D366;border:none;border-radius:12px;color:white;font-family:'Montserrat',sans-serif;font-size:13px;font-weight:700;cursor:pointer;text-decoration:none;}
.btn-wa-grupo:hover{background:#1db954;}

.card-menta{background:white;border:1.5px solid var(--menta);border-radius:16px;padding:18px 20px;margin-bottom:14px;}
.menta-label{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#4a7a2a;margin-bottom:6px;}
.footer{text-align:center;padding:16px 0 0;border-top:1px solid var(--border);margin-top:6px;}
.day-nav{display:flex;justify-content:space-between;align-items:center;}
.dots{display:flex;gap:5px;align-items:center;}
.dot{width:6px;height:6px;border-radius:50%;background:var(--border);}
.dot.done{background:var(--azul);}
.dot.active{background:var(--azul);width:20px;border-radius:3px;}
.nav-label{font-size:11px;color:var(--muted);font-weight:500;}
</style>
</head>
<body>

<div class="progress-bar-wrap">
  <span class="progress-label">Tu progreso</span>
  <div class="progress-track"><div class="progress-fill" id="progress-fill" style="width:0%"></div></div>
  <span class="progress-pts" id="progress-pts">0/7 ⭐</span>
</div>
<div class="day-chips">
  <div class="chip" id="chip1">1</div><div class="chip" id="chip2">2</div>
  <div class="chip" id="chip3">3</div><div class="chip" id="chip4">4</div>
  <div class="chip active" id="chip5">5</div>
  <div class="chip" id="chip6">6</div><div class="chip" id="chip7">7</div>
</div>

<div class="header">
  <div class="logo-text">feminario</div>
  <div class="logo-sub">el espacio seguro donde las mujeres redefinimos la autonomía económica</div>
  <div class="header-pill">Reto Feminversario · Día 5 de 7 · 14 de mayo</div>
  <h1 class="header-title">Hoy no reflexionamos. <em>Hoy hacemos.</em></h1>
  <p class="header-sub-text">El único día del reto donde la tarea es una sola acción real.</p>
</div>

<div class="content">

  <!-- BANNER DE ACCIÓN -->
  <div class="accion-banner">
    <div class="accion-emoji">⚡</div>
    <div class="accion-title">Este día es diferente.</div>
    <div class="accion-sub">No hay lectura larga. No hay cálculo. Hay una sola tarea: tomar una acción financiera real hoy.<br><br>El miedo no se va esperando. Se va haciendo.</div>
  </div>

  <!-- SELECTOR -->
  <div class="card">
    <div class="card-label">¿Cuál es tu punto de partida hoy?</div>
    <div class="card-title">Selecciona tu situación actual</div>
    <div class="situacion-grid">
      <div class="situ-btn" id="btn-nueva" onclick="seleccionar('nueva')">
        <div class="situ-icon">🌱</div>
        <div class="situ-name">Nunca he invertido</div>
        <div class="situ-desc">Hoy abro mi primera cuenta de inversiones</div>
      </div>
      <div class="situ-btn" id="btn-ya" onclick="seleccionar('ya')">
        <div class="situ-icon">📈</div>
        <div class="situ-name">Ya tengo cuenta</div>
        <div class="situ-desc">Hoy reviso, ajusto o aporto a lo que tengo</div>
      </div>
    </div>
  </div>

  <!-- CAMINO A: NUNCA HA INVERTIDO → XTB -->
  <div class="xtb-card" id="xtb-card">
    <div class="card-label">Tu tarea de hoy</div>
    <div class="card-title">Abre tu cuenta de inversiones ahora mismo.</div>
    <p class="card-body">La plataforma que usamos en Feminario es <strong>XTB</strong> — una de las más grandes del mundo, con acceso a más de 6.000 instrumentos financieros, sin comisión en los primeros $100.000 USD al mes.</p>

    <div class="xtb-banner">
      <div class="xtb-logo">XTB · Plataforma de inversiones</div>
      <div class="xtb-headline">Abre tu cuenta gratuita hoy</div>
      <div class="xtb-sub">Sin depósito mínimo. Sin comisión hasta $100.000 USD al mes. Regulada internacionalmente. La misma plataforma que usamos Andrea y Tina.</div>
      <div class="xtb-warning">⚠️ Es importante abrir la cuenta usando el link de abajo. Es el único link habilitado para nuestra comunidad.</div>
      <a class="btn-xtb" href="https://geolink.xtb.com/yxxw1" target="_blank" onclick="marcarXTB()">
        → Abrir mi cuenta en XTB ahora
      </a>
    </div>

    <div class="pasos">
      <div class="card-label" style="margin-bottom:8px;">Paso a paso: qué hacer después de abrir la cuenta</div>
      <div class="paso">
        <div class="paso-num">1</div>
        <div class="paso-content">
          <div class="paso-title">Haz clic en el link de arriba</div>
          <div class="paso-desc">Se abre el registro de XTB. Llena tus datos básicos. El proceso toma <strong>menos de 5 minutos</strong>.</div>
        </div>
      </div>
      <div class="paso">
        <div class="paso-num">2</div>
        <div class="paso-content">
          <div class="paso-title">Verifica tu identidad</div>
          <div class="paso-desc">Van a pedirte tu cédula y una foto. Es un proceso regulado — completamente normal y seguro.</div>
        </div>
      </div>
      <div class="paso">
        <div class="paso-num">3</div>
        <div class="paso-content">
          <div class="paso-title">Haz tu primer depósito</div>
          <div class="paso-desc">El monto lo decides tú. <strong>No hay mínimo</strong>. Puedes empezar con lo que tengas disponible hoy.</div>
        </div>
      </div>
      <div class="paso">
        <div class="paso-num">4</div>
        <div class="paso-content">
          <div class="paso-title">Cuéntalo en el grupo del reto</div>
          <div class="paso-desc">No tienes que decir cuánto. Solo que lo hiciste. Ese mensaje es el más poderoso del reto.</div>
        </div>
      </div>
    </div>

    <div style="margin-top:16px;background:var(--crema);border-radius:12px;padding:14px;border:1px solid var(--dorado);">
      <p style="font-size:12px;color:var(--muted);line-height:1.7;"><strong style="color:var(--texto);">¿Y si me da miedo?</strong> Normal. El 78% de las personas que nunca han invertido dicen que el miedo es el principal freno. Pero el miedo no se va leyendo más — se va haciendo algo pequeño. Abrir la cuenta ya es ese algo.</p>
    </div>

    <!-- CONFIRMACIÓN XTB -->
    <div style="margin-top:14px;">
      <p style="font-size:12px;color:var(--muted);margin-bottom:8px;">Cuando hayas abierto la cuenta, confirma aquí:</p>
      <button class="btn-primary" id="btn-confirm-xtb" onclick="confirmarAccion('xtb')" style="margin-top:0;">
        ✓ Abrí mi cuenta en XTB
      </button>
    </div>
  </div>

  <!-- CAMINO B: YA INVIERTE -->
  <div class="ya-invierte-card" id="ya-invierte-card">
    <div class="card-label">Tu tarea de hoy</div>
    <div class="card-title">Ya tienes cuenta. Hoy la revisas y haces algo con ella.</div>
    <p class="card-body" style="margin-bottom:14px;">Elige una o más de estas acciones. Lo que sea — pero algo real, hoy:</p>

    <div class="opciones-grid" id="opciones">
      <label class="opcion-check" id="op1">
        <input type="checkbox" onchange="checkOpcion()">
        <div class="opcion-label">Hice un nuevo aporte a mi cuenta de inversiones
          <span>Cualquier monto. Reforzar el hábito es lo que importa.</span>
        </div>
      </label>
      <label class="opcion-check" id="op2">
        <input type="checkbox" onchange="checkOpcion()">
        <div class="opcion-label">Revisé mi portafolio y entendí qué tengo
          <span>Sé qué instrumentos tengo, cuánto llevan de rendimiento y por qué los elegí.</span>
        </div>
      </label>
      <label class="opcion-check" id="op3">
        <input type="checkbox" onchange="checkOpcion()">
        <div class="opcion-label">Configuré o revisé mis aportes automáticos
          <span>El ahorro automático es la herramienta más poderosa que existe.</span>
        </div>
      </label>
      <label class="opcion-check" id="op4">
        <input type="checkbox" onchange="checkOpcion()">
        <div class="opcion-label">Aprendí algo nuevo sobre lo que tengo invertido
          <span>Leí, busqué, pregunté. Entender lo que tienes ya es acción.</span>
        </div>
      </label>
      <label class="opcion-check" id="op5">
        <input type="checkbox" onchange="checkOpcion()">
        <div class="opcion-label">Abrí una cuenta adicional o en una nueva plataforma
          <span>Diversificar también es una decisión.</span>
        </div>
      </label>
    </div>

    <div class="confirm-card" id="confirm-ya">
      <div class="confirm-inner">
        <div class="confirm-emoji">⚡</div>
        <div class="confirm-title">¡Eso cuenta! Ya tomaste acción hoy.</div>
        <div class="confirm-sub">Cada vez que haces algo con tu plata en lugar de posponerlo, estás cerrando la brecha que viste en los últimos días.</div>
      </div>
    </div>

    <button class="btn-primary" id="btn-confirm-ya" onclick="confirmarAccion('ya')" style="display:none;margin-top:12px;">
      ✓ Confirmé mi acción de hoy
    </button>
  </div>

  <!-- REFLEXIÓN (aparece después de confirmar) -->
  <div class="card" id="reflexion-card" style="display:none;">
    <div class="card-label">Una sola pregunta</div>
    <div class="card-title">¿Qué hiciste hoy? Solo eso.</div>
    <p class="card-body">No tienes que justificarlo ni explicarlo. Solo describe en una frase la acción que tomaste.</p>
    <textarea class="reflection-area" id="reflection" placeholder="Ej: 'Abrí mi cuenta en XTB' / 'Hice mi primer aporte' / 'Revisé mi portafolio por primera vez'" oninput="guardarTexto()"></textarea>
    <button class="btn-primary" id="save-btn" onclick="guardar()">✓ Completar el Día 5 y ganar mi punto</button>
  </div>

  <!-- CELEBRACIÓN -->
  <div class="celebracion" id="celebracion">
    <div class="celebracion-emoji">🎉⚡</div>
    <div class="celebracion-title" id="cel-title">¡Lo hiciste! Hoy pasaste del 'voy a hacerlo' al 'lo hice'.</div>
    <div class="celebracion-sub">Ese momento es el más importante de la semana. Cuéntaselo a la comunidad — tu mensaje puede ser el empujón que otra mujer necesitaba.</div>
    <div class="wa-steps">
      <div>
        <div class="wa-step-label">Paso 1 · Copia este mensaje</div>
        <div class="msg-box" id="wa-msg">Lo hice ⚡

Completé el Día 5 del Reto Feminversario de Feminario y tomé mi primera acción financiera real.

El miedo no se va esperando. Se va haciendo.

¿Ya lo hiciste tú?
#RetoFeminversario</div>
        <button class="btn-copy" id="copy-btn" onclick="copiarMensaje()">📋 Copiar mensaje</button>
      </div>
      <div>
        <div class="wa-step-label">Paso 2 · Ábrelo en el grupo</div>
        <a class="btn-wa-grupo" href="https://chat.whatsapp.com/BGQ1akFdvSz0zVQtjgZFxN" target="_blank">💬 Abrir grupo del reto en WhatsApp</a>
      </div>
    </div>
  </div>

  <div class="card-menta" id="manana-card" style="display:none;">
    <div class="menta-label">Mañana · Día 6</div>
    <div class="card-title" style="font-size:15px;">Tu red de seguridad.</div>
    <p class="card-body">El día 6 calculas tu fondo de emergencia ideal — y el primer paso real para construirlo. Porque invertir sin una red de seguridad es como construir sin cimientos.</p>
    <p class="card-body" style="margin-top:8px;color:#4a7a2a;font-weight:600;">No necesitas preparar nada para mañana.</p>
  </div>

  <div class="footer">
    <div class="day-nav">
      <span class="nav-label">Día 5</span>
      <div class="dots">
        <div class="dot done"></div><div class="dot done"></div><div class="dot done"></div><div class="dot done"></div>
        <div class="dot active"></div>
        <div class="dot"></div><div class="dot"></div>
      </div>
      <span class="nav-label">7 días</span>
    </div>
    <p style="margin-top:14px;font-size:11px;color:#c0bbd0;">Feminario · Reto Feminversario · Mayo 2026</p>
  </div>
</div>

<script>
function save(k,v){try{localStorage.setItem(k,v);}catch(e){}}
function load(k){try{return localStorage.getItem(k)||'';}catch(e){return '';}}
let situacion='';

function actualizarProgreso(){
  const dias=['femi_d1_listo','femi_d2_listo','femi_d3_listo','femi_d4_listo','femi_d5_listo','femi_d6_listo','femi_d7_listo'];
  const pts=dias.filter(d=>load(d)==='1').length;
  document.getElementById('progress-fill').style.width=(pts/7*100)+'%';
  document.getElementById('progress-pts').textContent=pts+'/7 ⭐';
  dias.forEach((d,i)=>{
    const c=document.getElementById('chip'+(i+1));
    if(!c)return;
    if(load(d)==='1'){c.classList.add('done');c.classList.remove('active');c.textContent='✓';}
    else if(i===4&&load(d)!=='1'){c.classList.add('active');}
  });
}

function seleccionar(tipo){
  situacion=tipo;
  save('femi_d5_tipo',tipo);
  document.querySelectorAll('.situ-btn').forEach(b=>b.classList.remove('selected'));
  document.getElementById('btn-'+tipo).classList.add('selected');
  document.getElementById('xtb-card').classList.remove('visible');
  document.getElementById('ya-invierte-card').classList.remove('visible');
  if(tipo==='nueva') document.getElementById('xtb-card').classList.add('visible');
  else document.getElementById('ya-invierte-card').classList.add('visible');
}

function marcarXTB(){
  save('femi_d5_xtb_click','1');
}

function confirmarAccion(tipo){
  save('femi_d5_accion',tipo);
  document.getElementById('reflexion-card').style.display='block';
  document.getElementById('manana-card').style.display='block';
  if(tipo==='xtb'){
    document.getElementById('btn-confirm-xtb').textContent='✓ ¡Cuenta abierta!';
    document.getElementById('btn-confirm-xtb').classList.add('saved');
  } else {
    document.getElementById('confirm-ya').classList.add('visible');
    document.getElementById('btn-confirm-ya').style.display='none';
  }
  document.getElementById('reflexion-card').scrollIntoView({behavior:'smooth',block:'start'});
}

function checkOpcion(){
  const checked=document.querySelectorAll('#opciones input[type=checkbox]:checked').length;
  const btn=document.getElementById('btn-confirm-ya');
  if(checked>0){
    btn.style.display='block';
    document.getElementById('confirm-ya').classList.add('visible');
  }
}

function guardarTexto(){save('femi_d5_reflexion',document.getElementById('reflection').value);}

function copiarMensaje(){
  const txt=document.getElementById('wa-msg').textContent;
  navigator.clipboard.writeText(txt).then(()=>{
    document.getElementById('copy-btn').textContent='✅ ¡Copiado! Ahora pégalo en el grupo';
  }).catch(()=>{
    const r=document.createRange();r.selectNode(document.getElementById('wa-msg'));
    window.getSelection().removeAllRanges();window.getSelection().addRange(r);
    document.execCommand('copy');
    document.getElementById('copy-btn').textContent='✅ ¡Copiado!';
  });
}

function guardar(){
  const btn=document.getElementById('save-btn');
  if(!load('femi_d5_accion')){
    btn.textContent='Primero confirma la acción que tomaste ↑';
    btn.style.background='#b07040';
    setTimeout(()=>{btn.textContent='✓ Completar el Día 5 y ganar mi punto';btn.style.background='';},2200);
    return;
  }
  save('femi_d5_listo','1');
  save('femi_d5_accion_texto',document.getElementById('reflection').value);
  btn.textContent='✓ ¡Día 5 completado! +1 punto';
  btn.classList.add('saved');
  actualizarProgreso();
  const nombre=load('femi_nombre')||'';
  document.getElementById('cel-title').textContent='¡Lo hiciste'+(nombre?', '+nombre:'')+'!\nHoy pasaste del "voy a hacerlo" al "lo hice".';
  document.getElementById('celebracion').classList.add('visible');
  document.getElementById('celebracion').scrollIntoView({behavior:'smooth',block:'center'});
}

window.addEventListener('load',()=>{
  actualizarProgreso();
  const tipo=load('femi_d5_tipo');
  const r=load('femi_d5_reflexion');
  if(r) document.getElementById('reflection').value=r;
  if(tipo) seleccionar(tipo);
  if(load('femi_d5_accion')){
    document.getElementById('reflexion-card').style.display='block';
    document.getElementById('manana-card').style.display='block';
  }
  if(load('femi_d5_listo')==='1'){
    const btn=document.getElementById('save-btn');
    btn.textContent='✓ ¡Día 5 completado! +1 punto';
    btn.classList.add('saved');
    const nombre=load('femi_nombre')||'';
    document.getElementById('cel-title').textContent='¡Lo hiciste'+(nombre?', '+nombre:'')+'!\nHoy pasaste del "voy a hacerlo" al "lo hice".';
    document.getElementById('celebracion').classList.add('visible');
  }
});
</script>
</body>
</html>
